# ClaimAssist AI Environment Configuration

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM Configuration
# Modes: "openrouter" (recommended), "mock" (zero-cost deterministic test mode), or "openai"
LLM_PROVIDER=openrouter

# OpenRouter Settings (Recommended top model: anthropic/claude-3.5-sonnet or meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Settings (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Retrieval Configuration
RETRIEVAL_THRESHOLD=0.35
TOP_K_CHUNKS=3
POLICY_PATH=data/policy.md
CLAIMS_PATH=data/claims.json

# Tool Settings
CLAIM_TOOL_TIMEOUT_SECONDS=5.0
MAX_TOOL_CALL_ROUNDS=3
